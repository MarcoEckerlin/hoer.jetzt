# ---------------------------------------------------------------- Discord
HJ_BOT_TOKEN=
HJ_DISCORD_CLIENT_ID=
HJ_DISCORD_CLIENT_SECRET=

# ---------------------------------------------------------------- Web
# Muss zeichengenau im Developer Portal als Redirect hinterlegt sein
# (mit /auth/discord/callback am Ende).
HJ_WEB_BASE_URL=https://hoer.jetzt
# Nur lokal binden, wenn ein Reverse Proxy davor sitzt.
HJ_WEB_BIND=127.0.0.1

# ---------------------------------------------------------------- Datenbank
# Bestehende MariaDB, laeuft ausserhalb des Stacks.
HJ_DB_HOST=172.19.1.110
HJ_DB_PORT=3306
HJ_DB_NAME=discordbot
HJ_DB_USER=discordbot
HJ_DB_PASSWORD=

# Trennt mehrere Instanzen in derselben Datenbank.
HJ_BOT_ID=1

# ---------------------------------------------------------------- Audio
# Gilt fuer alle Knoten dieses Stacks. Knoten auf eigenen Hosts duerfen
# ein eigenes Passwort haben - dann im Adminbereich entsprechend eintragen.
HJ_LAVALINK_PASSWORD=

# ---------------------------------------------------------------- Sprachmodell
# Leer lassen, wenn keines vorhanden ist: KI-Chat und AI-Radio bleiben dann aus.
HJ_LLM_OLLAMA_URL=
HJ_LLM_MODEL=

# ---------------------------------------------------------------- Versionen
CORE_TAG=latest
AI_RADIO_TAG=latest
LAVALINK_TAG=latest

# ---------------------------------------------------------------- Tailscale
# Nur fuer docker-compose.tailscale.yml. Verbindet mehrere Hosts zu einem
# privaten Netz; Audio-Knoten brauchen dann keinen offenen Port mehr.
# Key erzeugen: Tailscale-Adminbereich -> Settings -> Keys (Reusable an).
TS_AUTHKEY=
TS_HOSTNAME=hoerjetzt-core
# MagicDNS in Containern ist unzuverlaessig - Knoten ueber 100er-Adresse
# eintragen. Wer es trotzdem will, setzt hier true.
TS_ACCEPT_DNS=false
# Zusaetzliche Argumente fuer "tailscale up". Leer lassen.
# --advertise-tags=tag:... geht erst, wenn der Tag in den Tailnet-ACLs unter
# tagOwners eingetragen ist - sonst verweigert die Anmeldung den Dienst.
TS_EXTRA_ARGS=

# Host-Port der Weboberflaeche. Nur aendern, wenn 8080 schon belegt ist -
# im Container bleibt es 8080, der Reverse Proxy zeigt dann hierher.
HJ_WEB_PORT_HOST=8080
