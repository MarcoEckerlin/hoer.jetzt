# ---------------------------------------------------------------- Discord
HJ_BOT_TOKEN=
HJ_DISCORD_CLIENT_ID=
HJ_DISCORD_CLIENT_SECRET=

# ---------------------------------------------------------------- Web
# Muss zeichengenau im Developer Portal als Redirect hinterlegt sein
# (mit /auth/discord/callback am Ende).
HJ_WEB_BASE_URL=https://hoer.jetzt
# Nur lokal binden, wenn ein Reverse Proxy davor sitzt.
HJ_WEB_BIND=127.0.0.1

# ---------------------------------------------------------------- Datenbank
# Bestehende MariaDB, laeuft ausserhalb des Stacks.
HJ_DB_HOST=172.19.1.110
HJ_DB_PORT=3306
HJ_DB_NAME=discordbot
HJ_DB_USER=discordbot
HJ_DB_PASSWORD=

# Trennt mehrere Instanzen in derselben Datenbank.
HJ_BOT_ID=1

# ---------------------------------------------------------------- Audio
# Gilt fuer alle Knoten dieses Stacks. Knoten auf eigenen Hosts duerfen
# ein eigenes Passwort haben - dann im Adminbereich entsprechend eintragen.
HJ_LAVALINK_PASSWORD=

# Sekunden zwischen zwei Abgleichen der Knotentabelle. Ein neuer Knoten kommt
# damit von selbst dazu - ohne den Bot neu zu starten. 0 schaltet das ab.
HJ_LAVALINK_WATCH_SECONDS=30

# Sind alle Standard-Knoten ausgelastet, duerfen Standard-Server auf einen
# Premium-Knoten ausweichen. Sonst blieben sie stumm, waehrend nebenan
# Kapazitaet frei steht. Premium behaelt Vorrang: der Ueberlauf nimmt nur
# Knoten mit Luft, und ein Platz bleibt reserviert.
HJ_LAVALINK_FREE_OVERFLOW=true
# Ab welcher Systemlast ein Knoten als voll gilt (0.5 bis 0.99).
HJ_LAVALINK_OVERFLOW_CPU=0.85
# Reservierte Plaetze je Premium-Knoten.
HJ_LAVALINK_PREMIUM_RESERVE=1

# Wo die Anmeldungen liegen.
#
# Leer = im Arbeitsspeicher des Bots. Dann ist man nach jedem Neustart und auf
# jeder anderen Node abgemeldet - bei zwei Nodes hinter einem Load Balancer
# heisst das: etwa jede zweite Anfrage.
#
# "datenbank" legt sie in PostgreSQL ab. Die ist ohnehin auf allen Nodes
# dieselbe, also gilt eine Anmeldung ueberall und ueberlebt Neustarts.
# Die noetigen Tabellen legt der Bot beim ersten Start selbst an - danach
# einmal "spock-einrichten.sh anlegen" laufen lassen, damit sie in den
# Abgleich zwischen den Nodes aufgenommen werden.
HJ_SESSION_STORE=datenbank

# Notfalltuer fuer den Adminzugang.
#
# Normalerweise uebernimmt sich der Eigentuemer der Discord-Anwendung beim
# ersten Aufruf von /admin selbst. Das greift aber nicht, wenn die Anwendung
# einem Team gehoert - dann zaehlt nur der Team-Eigentuemer - oder wenn Discord
# im entscheidenden Moment nicht antwortet. Ohne diese Zeile bliebe dann nur
# der Weg ueber die Datenbank.
#
# Discord-Benutzer-IDs, mit Komma getrennt. Eingetragen wird erst, wenn sich
# die Person anmeldet. Danach kann die Zeile wieder raus - der Eintrag bleibt.
#   ID herausfinden: Discord -> Einstellungen -> Erweitert -> Entwicklermodus,
#   dann Rechtsklick auf den eigenen Namen -> "Benutzer-ID kopieren"
HJ_BOT_ADMIN_IDS=

# ---------------------------------------------------------------- Verbund
# Nummer dieser Node. Bestimmt den Zahlenraum, aus dem die Datenbank ihre
# fortlaufenden Nummern vergibt: Node 1 nimmt 1, 1001, 2001 - Node 2 nimmt
# 2, 1002, 2002. Zwei Nodes mit derselben Nummer kollidieren beim Abgleich.
HJ_NODE_NR=1

# Die 10.x-Adresse dieser Maschine im Hetzner Private Network. Nur ueber sie
# erreichen sich die Nodes - nach aussen bleibt der Datenbank-Port zu.
# Steht nach dem Anlegen des Netzes in der Hetzner-Konsole.
HJ_PRIVAT_IP=

# Abbild fuer den Multi-Master-Betrieb. Spock braucht ein gepatchtes
# PostgreSQL, deshalb ein fertiges Abbild statt "Erweiterung nachinstallieren".
# Nur noetig mit docker-compose.spock.yml.
HJ_PG_IMAGE=ghcr.io/pgedge/pgedge-postgres:16-spock5-standard

# Zentrale Steuerung. Auf der Steuer-Node beides setzen, auf den anderen nur
# die URL - dort bleibt die Schnittstelle ohne Token dicht.
#   openssl rand -hex 32
HJ_CONTROLLER_URL=http://10.0.0.2:8080
HJ_CONTROLLER_TOKEN=
# Name dieser Node im Verbund. Leer = Rechnername.
HJ_NODE_NAME=

# Shards. Leer = der Bot fragt Discord nach der empfohlenen Zahl; fuer eine
# einzelne Node genau richtig. Bei mehreren Prozessen duerfen sich VON und BIS
# NIE ueberlappen - Discord erlaubt je Shard-Nummer genau eine Verbindung und
# wirft beide hinaus, die sich streiten.
#
#   Prozess A:  HJ_SHARDS_GESAMT=4  HJ_SHARD_VON=0  HJ_SHARD_BIS=1
#   Prozess B:  HJ_SHARDS_GESAMT=4  HJ_SHARD_VON=2  HJ_SHARD_BIS=3
HJ_SHARDS_GESAMT=
HJ_SHARD_VON=
HJ_SHARD_BIS=

# Redis. Leer lassen schaltet den Verbund ab - dann laeuft alles wie vorher.
HJ_REDIS_HOST=redis
HJ_REDIS_PORT=6379
HJ_REDIS_PASSWORD=

# YouTube: Entschluesselung durch den Dienst yt-cipher. Leer lassen ist in
# Ordnung - dann laeuft der Dienst ohne Passwort im internen Netz.
YT_CIPHER_PASSWORD=

# ---------------------------------------------------------------- Sprachmodell
# Leer lassen, wenn keines vorhanden ist: KI-Chat und AI-Radio bleiben dann aus.
HJ_LLM_OLLAMA_URL=
HJ_LLM_MODEL=

# ---------------------------------------------------------------- Versionen
CORE_TAG=latest
AI_RADIO_TAG=latest
LAVALINK_TAG=latest

HJ_WEB_PORT_HOST=8080


# ---------------------------------------------------------------- Weitere Knoten
# Nur fuer docker-compose.nodes.yml. Ports 2334, 2335, 2336.
NODE2_TIER=free
NODE3_TIER=free
NODE4_TIER=premium
# Auf welcher Adresse die zusaetzlichen Knoten lauschen.
HJ_NODE_BIND=0.0.0.0

# ---------------------------------------------------------------- YouTube
# Altersbeschraenkte Titel (viel Metal, Rap, aeltere Musikvideos) liefert
# YouTube nur an angemeldete Clients. true setzen, dann erscheint beim ersten
# Start ein Geraetecode im Log; den bestaetigten refreshToken hier eintragen.
YOUTUBE_OAUTH=false
YOUTUBE_REFRESH_TOKEN=
