[Unit]
Description=DiscordBot Music Brain Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=discordbot
Group=discordbot
WorkingDirectory=/opt/discordbot-music-brain
ExecStart=/usr/bin/java -Xms128m -Xmx384m -jar /opt/discordbot-music-brain/discordbot-music-brain.jar
Restart=always
RestartSec=5
SuccessExitStatus=143

[Install]
WantedBy=multi-user.target
