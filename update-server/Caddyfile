# hoer.jetzt - was der Update-Server nach aussen gibt.
#
# ---------------------------------------------------------------------------
# Kein TLS hier drin. Das macht der Nginx Proxy Manager.
#
# Caddy spricht auf diesem Port einfaches HTTP und ist nur im LAN erreichbar.
# Die Kette ist: Cloudflare -> NPM -> hierher. NPM haelt das Zertifikat, wie
# fuer alles andere auf diesem Anschluss auch.
#
# Was dadurch wegfaellt: eigene CA, Serverzertifikat, Client-Zertifikate,
# ACME, Port 80. Ein Knoten braucht kein einziges Zertifikat mehr, sondern
# ein Passwort - und das ueberlebt jeden Reverse-Proxy, waehrend ein
# Client-Zertifikat es nicht tut.
#
# ---------------------------------------------------------------------------
# Zwei Zugaenge:
#
#   /knoten/    Kurzes Passwort, tippbar. Gibt das Installationsskript und
#               die Compose-Dateien heraus - sonst nichts. Wird einmal beim
#               Aufsetzen gebraucht.
#
#   alles Uebrige (Abbilder, Release, Tresor, Melden)
#               Das Knoten-Passwort: 4096 Bit Zufall. Zusaetzlich muss die
#               Adresse freigeschaltet sein.
#
# Beide Pruefungen macht der Updater, nicht Caddy - deshalb forward_auth.
# Der Grund ist derselbe wie bei den Freigaben: eine Aenderung soll sofort
# gelten, ohne den Webserver neu zu laden. Und es gibt genau eine Stelle,
# die ueber Zugang entscheidet, statt zwei, die auseinanderlaufen koennen.
#
# ---------------------------------------------------------------------------
# Die Adresse des Aufrufers
#
# Hinter Cloudflare und NPM ist die Gegenstelle dieser Verbindung der NPM,
# nicht der Knoten. Die echte Adresse steht in den Koepfen, und welcher davon
# zaehlt, entscheidet der Updater - siehe TorController. Caddy reicht sie nur
# unveraendert durch.

{
	# Kein automatisches HTTPS: es gibt keinen Namen, fuer den Caddy ein
	# Zertifikat holen sollte. Ohne diese Zeile versucht es das trotzdem und
	# will dafuer Port 80.
	auto_https off
}

:{$HJ_PORT_INTERN} {
	encode zstd gzip

	log {
		output file /data/zugriff.log {
			roll_size 20MiB
			roll_keep 5
		}
	}

	header {
		X-Content-Type-Options "nosniff"
		-Server
	}

	# X-Knoten traegt die Kennung des angemeldeten Knotens - gesetzt von der
	# Pruefung weiter unten, nicht vom Aufrufer. Deshalb wird ein
	# mitgeschickter Kopf hier zuerst entfernt.
	#
	# Ohne diese Zeile bliebe ein selbst gesetztes X-Knoten stehen, sobald die
	# Pruefung keines liefert - und /melden nimmt die Kennung genau daraus.
	# Ein Knoten koennte sich dann als ein anderer melden und dessen Eintrag
	# ueberschreiben. Zwei Zeilen, die man leicht uebersieht, und ein Loch,
	# das man nur mit Blick auf beide findet.
	request_header -X-Knoten

	# Die Pruefung als wiederverwendbarer Baustein. 2xx heisst durchlassen,
	# alles andere geht unveraendert an den Aufrufer zurueck.
	(zugang) {
		forward_auth updater:8080 {
			uri /intern/pruefen
			copy_headers X-Knoten
		}
	}

	# ------------------------------------------------------------- Registry
	#
	# "route" statt einfach untereinander: Caddy sortiert Direktiven sonst
	# nach einer festen Rangfolge, und dabei kaeme der reverse_proxy vor die
	# Pruefung - die liefe dann ins Leere.
	handle /v2/* {
		route {
			import zugang
			reverse_proxy forgejo:3000 {
				# Abbild-Schichten sind gross. Die Vorgabe von 30s wuerde den
				# Upload beim Veroeffentlichen mittendrin abschneiden.
				transport http {
					read_timeout 30m
					write_timeout 30m
				}
			}
		}
	}

	# ------------------------------------------------------------- Release
	handle /release/* {
		route {
			import zugang
			root * /srv/ausliefern
			file_server
		}
	}

	# ------------------------------------------------------------- Tresor
	#
	# Kein file_server mehr.
	#
	# Vorher gab Caddy hier eine Datei aus dem Auslieferungsverzeichnis
	# heraus - fuer jeden Knoten dieselbe und im Klartext. Wer das Passwort
	# hatte, hatte Bot-Token, Datenbank-Passwort und Client-Secret.
	#
	# Jetzt laeuft der Abruf durch den Updater, denn erst der weiss, WER
	# fragt: er richtet den Inhalt an den oeffentlichen Schluessel dieses
	# Knotens. Zwei Knoten bekommen zwei verschiedene Antworten, und keiner
	# kann die des anderen oeffnen.
	handle /tresor/* {
		route {
			import zugang
			rewrite * /intern{uri}
			reverse_proxy updater:8080
		}
	}

	# ------------------------------------------------------- Schluessel
	#
	# Wo ein Knoten seinen oeffentlichen Schluessel hinterlegt. Der private
	# bleibt bei ihm - deshalb kann dieser Server einen Tresor, den er selbst
	# geschlossen hat, hinterher nicht mehr oeffnen.
	handle /schluessel {
		route {
			import zugang
			rewrite * /intern/schluessel
			reverse_proxy updater:8080
		}
	}

	# ------------------------------------------------------------- Melden
	handle /melden {
		route {
			import zugang
			rewrite * /intern/melden
			reverse_proxy updater:8080
		}
	}

	# ---------------------------------------------------------- Sicherungen
	#
	# Wohin die Controller alle drei Stunden ihren pg_dump schieben. Nur sie -
	# die Faehigkeit SICHERUNG_SCHREIBEN haengt am Modul CONTROLLER, ein
	# Audio-Knoten kommt hier nicht durch.
	#
	# Die Zeitgrenzen sind grosszuegig: eine gewachsene Datenbank braucht
	# Minuten, und ein Abbruch mittendrin hinterlaesst eine Datei, die wie
	# eine Sicherung aussieht.
	handle /sicherung/* {
		route {
			import zugang
			rewrite * /intern{uri}
			reverse_proxy updater:8080 {
				transport http {
					read_timeout 30m
					write_timeout 30m
				}
			}
		}
	}

	# ------------------------------------------------------------- Anmelden
	#
	# Die Erstanmeldung eines Knotens: Bootstrap-Token gegen dauerhaftes
	# Geheimnis. Ohne Passwort und ohne Adresspruefung, denn beides hat ein
	# frisch bestellter Server noch nicht - genau das holt er sich hier.
	#
	# Geschuetzt ist der Weg durch den Token im Koerper: knotenspezifisch,
	# zwei Stunden gueltig, genau einmal einloesbar. Kein forward_auth also,
	# aber auch keine offene Tuer.
	handle /anmelden {
		route {
			rewrite * /intern/anmelden
			reverse_proxy updater:8080
		}
	}

	# ------------------------------------------------------------- Knoten
	#
	# Der einzige Bereich mit dem kurzen Passwort - und einer von zweien ohne
	# Adresspruefung. Das ist Absicht: ein frisch aufgesetzter Rechner ist
	# noch nicht freigeschaltet, und genau das Skript, das er hier holt,
	# sagt ihm, dass er es werden muss.
	handle /knoten/* {
		route {
			forward_auth updater:8080 {
				uri /intern/pruefen-knoten
			}
			root * /srv/ausliefern
			file_server
		}
	}

	# Alles andere gibt es hier nicht. Bewusst 404 und nicht 403: wer nur
	# Adressen durchprobiert, soll nicht erfahren, welche existieren.
	handle {
		respond "Nicht gefunden." 404
	}
}
