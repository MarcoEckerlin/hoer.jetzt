server:
  address: ${LAVALINK_ADDRESS}
  port: ${LAVALINK_PORT}

lavalink:
  server:
    password: "${LAVALINK_SERVER_PASSWORD}"

    # --- Verbindung -------------------------------------------------------
    # Wie lange Lavalink laufende Player nach einem Abriss der Bot-Verbindung
    # aufhebt. Der Bot meldet sich mit derselben Session zurueck und uebernimmt
    # sie wieder - das ist der Unterschied zwischen "Musik laeuft weiter" und
    # "nach kurzer Zeit ist Stille".
    #
    # Der verbindliche Wert kommt vom Bot (resume_timeout_seconds je Knoten);
    # dieser hier gilt, bis der Bot sich zum ersten Mal meldet.
    timeouts:
      connectTimeoutMs: 10000
      connectionRequestTimeoutMs: 10000
      socketTimeoutMs: 10000

    # --- Audio-Qualitaet -------------------------------------------------
    # opusEncodingQuality: 0-10, 10 = beste Encoder-Qualitaet (mehr CPU).
    # resamplingQuality: LOW ist der Lavalink-Standard und klingt hoerbar
    # dumpfer/rauer. HIGH nutzt einen besseren Resampler beim Umrechnen auf
    # die 48 kHz, die Discord verlangt.
    opusEncodingQuality: ${LAVALINK_OPUS_QUALITY}
    resamplingQuality: ${LAVALINK_RESAMPLING}

    # --- Puffer ----------------------------------------------------------
    # bufferDurationMs: JDA-Sendepuffer. Hoeher = weniger Aussetzer bei
    # kurzen Netzwerk-Hakeln, minimal mehr Latenz.
    # frameBufferDurationMs: vorausdekodierte Audioframes. Grosszuegig
    # gewaehlt, damit Webradio-Streams keine Dropouts erzeugen.
    bufferDurationMs: ${LAVALINK_BUFFER_MS}
    frameBufferDurationMs: ${LAVALINK_FRAME_BUFFER_MS}
    nonAllocatingFrameBuffer: false

    # Seek-Ghosting vermeidet den kurzen Stille-Sprung beim Spulen.
    useSeekGhosting: true

    # Player-Updates seltener senden entlastet den Bot spuerbar,
    # das Dashboard interpoliert die Position ohnehin selbst.
    playerUpdateInterval: 5

    # 10 Sekunden waren zu scharf: eine kurze Netzhaenger beim Nachladen eines
    # Streams reichte, und der Bot schaltete weiter, obwohl der Titel gleich
    # weitergelaufen waere. 30 Sekunden faengt das ab, ohne einen wirklich
    # toten Titel lange stehen zu lassen.
    trackStuckThresholdMs: 30000
    youtubePlaylistLoadLimit: 6

    filters:
      volume: true
      equalizer: true
      karaoke: false
      timescale: false
      tremolo: false
      vibrato: false
      distortion: false
      rotation: false
      channelMix: false
      lowPass: false

    sources:
      youtube: false
      http: true
      soundcloud: true
      bandcamp: true
      twitch: true
      vimeo: true
      local: false

  plugins:
    # YouTube aendert seine Endpunkte laufend. Ein veraltetes Plugin fuehrt zu
    # haengenden Tracks ("got stuck! Threshold surpassed") und zu Titeln, die
    # nur noch ueber schlechtere Ersatzformate laden. Diese Version daher bei
    # Problemen zuerst pruefen - Lavalink schreibt beim Start selbst eine
    # Warnung ins Log, wenn eine neuere verfuegbar ist.
    #
    # snapshot: true holt aus dem Entwicklungs-Repository. Dort heissen die
    # Versionen nach dem Commit, nicht nach 1.18.x - und dort steht der Stand,
    # der YouTubes aktuelles Player-Skript schon kennt. Umgestellt wird ueber
    # YOUTUBE_PLUGIN_SNAPSHOT und YOUTUBE_PLUGIN_VERSION, nicht hier.
    - dependency: "dev.lavalink.youtube:youtube-plugin:${YOUTUBE_PLUGIN_VERSION}"
      snapshot: ${YOUTUBE_PLUGIN_SNAPSHOT}

plugins:
  youtube:
    enabled: true
    allowSearch: true
    allowDirectVideoIds: true
    allowDirectPlaylistIds: true
    # Reihenfolge = Prioritaet. Scheitern alle Clients, meldet Lavalink
    # "AllClientsFailedException" - dann greift YouTubes Bot-Erkennung.
    # MWEB kommt mit regionsbeschraenkten Videos oft noch durch, wenn WEB
    # bereits blockiert wird.
    #
    # Unbekannte Client-Namen werden ohne Fehlermeldung verworfen. Nach einer
    # Aenderung deshalb im Log gegenpruefen, welche Clients wirklich geladen
    # wurden:  journalctl -u lavalink | grep "initialised with clients"
    # Altersbeschraenkte Titel koennen nur zwei Clients:
    #   WEBEMBEDDED  eingeschraenkt, ohne Anmeldung
    #   TV           vollstaendig, aber nur mit OAuth (YOUTUBE_OAUTH=true)
    # Alle anderen scheitern daran grundsaetzlich. Wer Rammstein und aehnliche
    # Kataloge braucht, kommt um die Anmeldung nicht herum.
    #
    # Unbekannte Namen werden ohne Fehler verworfen - nur eine WARN-Zeile
    # "Failed to resolve ... into a Client". Nach einer Aenderung deshalb im Log
    # gegenpruefen, was wirklich geladen wurde:
    #   docker logs <container> | grep "initialised with clients"
    clients:
      - MUSIC
      - TV
      - ANDROID_VR
      - MWEB
      - WEB
      - WEBEMBEDDED
    MUSIC:
      playback: true
      videoLoading: true
      searching: true
    ANDROID_VR:
      playback: true
      videoLoading: true
      searching: false

    # Anmeldung und Bot-Erkennung. Wird vom Startskript eingesetzt, wenn
    # YOUTUBE_OAUTH oder YOUTUBE_PO_TOKEN gesetzt sind - siehe entrypoint.sh.
${YOUTUBE_ZUSATZ}

logging:
  level:
    root: INFO
    lavalink: INFO
  request:
    enabled: false
  logback:
    rollingpolicy:
      max-history: 7
      max-file-size: 25MB
